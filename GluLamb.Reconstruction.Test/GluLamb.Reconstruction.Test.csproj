<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks for GluLamb.Reconstruction on synthetic beams (straight, curved, twisted, with joints
    cut into them): reconstructs them from their meshes and Breps and compares the results with the
    beams they were made from. Runs Rhino headless through Rhino.Inside, so it needs Rhino 8.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GluLamb.Reconstruction.Test</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rhino.Inside" Version="8.0.7-beta" />
    <PackageReference Include="RhinoCommon" Version="8.10.24226.13001">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Build into this project's own output, not the shared ..\bin plug-in folder -->
    <ProjectReference Include="..\GluLamb\GluLamb.csproj" AdditionalProperties="OutputPath=$(MSBuildThisFileDirectory)obj\GluLamb\;BaseOutputPath=$(MSBuildThisFileDirectory)obj\GluLamb\">
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\GluLamb.Reconstruction\GluLamb.Reconstruction.csproj" AdditionalProperties="OutputPath=$(MSBuildThisFileDirectory)obj\GluLamb.Reconstruction\;BaseOutputPath=$(MSBuildThisFileDirectory)obj\GluLamb.Reconstruction\">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
