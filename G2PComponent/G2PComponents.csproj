<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Deterministic>false</Deterministic>
	<PackageOutputPath>..\bin\</PackageOutputPath>
	<AssemblyVersion>2.0.*</AssemblyVersion>
	<FileVersion>2.0.*</FileVersion>
    <BaseOutputPath>..\bin</BaseOutputPath>
	<OutputPath>..\bin</OutputPath>
	  <TargetExt>.rhp</TargetExt>
	  <NoWarn>NU1701</NoWarn>
	  <Title>G2P Components</Title>
	  <Company>Tom Svilans</Company>
	  <Copyright>Copyright (c) 2025</Copyright>
  </PropertyGroup>
	
	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	
	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="RhinoCommon" Version="8.10.24226.13001" ExcludeAssets="runtime" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GluLamb\GluLamb.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="D2P_Core">
	    <HintPath>..\bin\D2P_Core.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<!-- D2P_Core isn't in this repository: build it from the D2P repository and put D2P_Core.dll in bin/. -->
	<Target Name="CheckD2PCore" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(MSBuildThisFileDirectory)..\bin\D2P_Core.dll')">
		<Error Text="G2PComponents needs D2P_Core.dll in bin/ (built from the D2P repository); it isn't part of this repository." />
	</Target>

</Project>
