<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Code written for specific projects (2022 HH DAC, 2024 CITA ReShelter), kept out of the core
    library. Built on demand; it isn't part of the plug-ins and doesn't build into ..\bin.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GluLamb.Projects</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.10.24226.13001">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GluLamb\GluLamb.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>