<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <AssemblyName>GluLamb.Rhino</AssemblyName>
    <RootNamespace>GWorks</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Deterministic>false</Deterministic>
    <AssemblyVersion>2.0.*</AssemblyVersion>
    <FileVersion>2.0.*</FileVersion>
    <Title>GluLamb.Rhino</Title>
    <Description>Rhino plug-in for GluLamb.</Description>
    <Company>Tom Svilans</Company>
    <Copyright>Copyright (c) 2025, Tom Svilans</Copyright>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <PackageOutputPath>..\bin\</PackageOutputPath>
    <OutputPath>..\bin</OutputPath>

  </PropertyGroup>
  
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>  

  <ItemGroup>
    <None Remove="Resources\BeamCurved.png" />
    <None Remove="Resources\GluLamb.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\BeamCurved.png" />
    <EmbeddedResource Include="Resources\GluLamb.ico" LogicalName="GluLamb.Resources.GluLamb.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.10.24226.13001" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Resources.Extensions" Version="7.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GluLamb\GluLamb.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
