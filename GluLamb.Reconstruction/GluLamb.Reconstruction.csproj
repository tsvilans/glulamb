<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reconstruction of beams and blanks from other geometry: free-form beams from meshes (IFC, OBJ,
    STL), and blanks from detailed Breps. Kept apart from GluLamb so that the core library doesn't
    carry it. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>false</Deterministic>
    <RootNamespace>GluLamb.Reconstruction</RootNamespace>
    <AssemblyVersion>2.0.*</AssemblyVersion>
    <FileVersion>2.0.*</FileVersion>
    <Title>GluLamb.Reconstruction</Title>
    <Company>Tom Svilans</Company>
    <Copyright>Copyright (c) 2026</Copyright>
    <BaseOutputPath>..\bin</BaseOutputPath>
    <OutputPath>..\bin</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- DualCon passes pointers to the native dualcon library -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.10.24226.13001">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GluLamb\GluLamb.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
