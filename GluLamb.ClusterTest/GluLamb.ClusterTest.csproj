<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Checks for Cluster Beams (GluLamb/Blanks/BeamClustering.cs): families of beams copied with
    random rigid transforms, reversal, half-turn roll and small perturbations must cluster as
    expected, mirrored double-curved beams must not, and each blank moved by its transform must
    land on its members. Runs Rhino headless through Rhino.Inside, so it needs Rhino 8 installed.
    See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>GluLamb.ClusterTest</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rhino.Inside" Version="8.0.7-beta" />
    <PackageReference Include="RhinoCommon" Version="8.10.24226.13001">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Build GluLamb into this project's own output, not the shared ..\bin plug-in folder -->
    <ProjectReference Include="..\GluLamb\GluLamb.csproj" AdditionalProperties="OutputPath=$(MSBuildThisFileDirectory)obj\GluLamb\;BaseOutputPath=$(MSBuildThisFileDirectory)obj\GluLamb\">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
